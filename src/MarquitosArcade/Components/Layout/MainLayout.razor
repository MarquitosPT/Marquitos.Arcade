@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="topnav">
    <a class="topnav-brand" href="/index.html">
        <span class="topnav-dot"></span>
        <span class="topnav-title">Game Arcade</span>
    </a>
    <div class="topnav-links">
        <a href="/index.html">Jogos</a>
        <a href="/pontuacoes.html">🏆 Pontuações</a>
        <AuthorizeView>
            <Authorized>
                <a href="Account/Manage" class="@AccountActiveClass">👤 @context.User.Identity?.Name</a>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="index.html" />
                    <button type="submit" class="topnav-linklike">Sair</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="Account/Login" class="@AccountActiveClass">Entrar</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<div class="page-scroll">
    <main class="account-shell">
        @Body
    </main>
</div>

<footer class="site-footer">
    <p>Game Arcade - by MarquitosPT</p>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string AccountActiveClass =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("Account", StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
