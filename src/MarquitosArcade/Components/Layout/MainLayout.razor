@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<div id="app">
    <nav class="topnav">
        <a class="topnav-brand" href="/">
            <img class="topnav-logo" src="/favicon3_64x64.png" alt="" width="32" height="32" />
            <span class="topnav-title">Game Arcade</span>
        </a>
        <div class="topnav-links">
            <div class="topnav-scroll">
                <NavLink href="/" Match="NavLinkMatch.All">Jogos</NavLink>
                <NavLink href="/pontuacoes" Match="NavLinkMatch.Prefix">Pontuações</NavLink>
            </div>
            <AuthorizeView>
                <Authorized>
                    <details class="topnav-dropdown">
                        <summary class="topnav-trigger @AccountActiveClass">Conta</summary>
                        <div class="topnav-dropdown-menu">
                            <a href="Account/Manage">Ver conta</a>
                            <hr />
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit">Sair</button>
                            </form>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Login" class="@AccountActiveClass">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>

            @* Ciclo sistema -> claro -> escuro, tratado por wwwroot/theme.js.
               O ícone visível é escolhido por CSS a partir do data-theme do
               <html>, por isso este markup é estático e não precisa de
               render mode interativo. *@
            <button type="button" class="theme-toggle" data-theme-toggle
                    title="Tema: sistema / claro / escuro" aria-label="Mudar o tema do site">
                <svg class="theme-icon theme-icon-auto" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="8" />
                    <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none" />
                </svg>
                <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4.2" />
                    <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />
                </svg>
                <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z" />
                </svg>
            </button>
        </div>
    </nav>

    <div class="page-scroll">
        @Body
    </div>

    <footer class="site-footer">
        <p>Game Arcade — by MarquitosPT</p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string AccountActiveClass =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("Account", StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
