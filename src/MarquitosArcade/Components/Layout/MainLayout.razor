@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<div id="app">
    <nav class="topnav">
        <a class="topnav-brand" href="/">
            <img class="topnav-logo" src="/favicon3_64x64.png" alt="" width="32" height="32" />
            <span class="topnav-title">Game Arcade</span>
        </a>
        <div class="topnav-links">
            <div class="topnav-scroll">
                <NavLink href="/" Match="NavLinkMatch.All">Jogos</NavLink>
                <NavLink href="/pontuacoes" Match="NavLinkMatch.Prefix">Pontuações</NavLink>
            </div>
            <AuthorizeView>
                <Authorized>
                    <details class="topnav-dropdown">
                        <summary class="topnav-trigger @AccountActiveClass">Conta</summary>
                        <div class="topnav-dropdown-menu">
                            <a href="Account/Manage">Ver conta</a>
                            <hr />
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit">Sair</button>
                            </form>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Login" class="@AccountActiveClass">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>

    <div class="page-scroll">
        @Body
    </div>

    <footer class="site-footer">
        <p>Game Arcade - by MarquitosPT</p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string AccountActiveClass =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("Account", StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
