@page "/"

<PageTitle>MarquitosPT - GameStudios Arcade</PageTitle>

<header class="hero">
    <div class="hero-inner">
        <img class="mascot" src="/logo2.png" alt="Marquitos Game Arcade" width="456" height="196" />
        <div class="hero-copy">
            <p class="brand-kicker">MARQUITOS</p>
            <h1>Game Arcade</h1>
            <p class="brand-copy">
                Uma arcada viva para juntar clássicos, projetos originais e novos
                desafios online.
            </p>
            <div class="hero-actions">
                <a class="hero-cta" href="#catalogo">Ver jogos ↓</a>
                <a class="hero-cta secondary" href="/pontuacoes">🏆 Ver pontuações</a>
            </div>
        </div>
    </div>
</header>

<main>
    <section class="section" id="catalogo">
        <div class="section-heading">
            <h2>Jogos disponíveis</h2>
            <p>O catálogo vai crescendo — volta sempre a espreitar.</p>
        </div>

        <div class="game-grid">
            <article class="game-card">
                <div class="game-card-top">
                    <span class="tag live">Já disponível</span>
                    <span class="game-emoji" aria-hidden="true">🍽️</span>
                </div>
                <h3>Tasca do Zé</h3>
                <p>
                    Gere os pedidos da tasca, prepara os pratos certos e serve os
                    clientes antes que percam a paciência.
                </p>
                <div class="game-card-actions">
                    <a class="tile-action" href="/games/tasca-do-ze/">Jogar agora</a>
                    <a class="tile-action ghost" href="/pontuacoes?jogo=tasca-do-ze#tasca-do-ze">🏆 Pontuações</a>
                </div>
            </article>

            <article class="game-card">
                <div class="game-card-top">
                    <span class="tag beta">Novo</span>
                    <span class="game-emoji" aria-hidden="true">🏓</span>
                </div>
                <h3>Pong Retro</h3>
                <p>
                    Releitura neon do clássico Pong, com modo 1 jogador (vs. CPU) ou
                    2 jogadores no mesmo ecrã.
                </p>
                <div class="game-card-actions">
                    <a class="tile-action" href="/games/pong/">Experimentar</a>
                    <a class="tile-action ghost" href="/pontuacoes?jogo=pong#pong">🏆 Pontuações</a>
                </div>
            </article>

            <article class="game-card muted">
                <div class="game-card-top">
                    <span class="tag soon">Em breve</span>
                    <span class="game-emoji" aria-hidden="true">🏎️</span>
                </div>
                <h3>Pixel Racer</h3>
                <p>Corridas arcade em pistas curtas com boost, drift e torneios.</p>
                <div class="game-card-actions">
                    <button class="tile-action muted" type="button" disabled>
                        A caminho
                    </button>
                </div>
            </article>

            <article class="game-card muted">
                <div class="game-card-top">
                    <span class="tag soon">Em breve</span>
                    <span class="game-emoji" aria-hidden="true">🧩</span>
                </div>
                <h3>Maze Run</h3>
                <p>
                    Labirintos rápidos com inimigos IA e níveis progressivamente mais
                    desafiantes.
                </p>
                <div class="game-card-actions">
                    <button class="tile-action muted" type="button" disabled>
                        A caminho
                    </button>
                </div>
            </article>
        </div>
    </section>
</main>
