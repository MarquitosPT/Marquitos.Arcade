@page "/"

<PageTitle>Jogos | Marquitos Arcade</PageTitle>

<header class="hero">
    <div class="hero-inner">
        <div class="hero-visual">
            <div class="hero-logo-shell">
                <img class="mascot" src="/logo3.png" alt="Marquitos Game Arcade" width="456" height="196" />
            </div>
            <p class="hero-note">Clássicos, projetos originais e desafios para bater recordes.</p>
        </div>
        <div class="hero-copy">
            <p class="brand-kicker">Joga. Compete. Volta amanhã.</p>
            <h1>A diversão é garantida!</h1>
            <p class="brand-copy">
                Uma arcada viva para juntar clássicos, projetos originais e novos
                desafios online.
            </p>
            <div class="hero-actions">
                <a class="hero-cta" href="#catalogo">
                    <svg class="hero-cta-icon" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4v14M6 12l6 6 6-6" />
                    </svg>
                    Ver jogos
                </a>
                <a class="hero-cta secondary" href="/pontuacoes">🏆 Ver pontuações</a>
            </div>
            <ul class="hero-stats">
                <li><strong>@Catalog.Count(g => g.IsPlayable)</strong><span>a jogar já</span></li>
                <li><strong>@Catalog.Length</strong><span>no catálogo</span></li>
                <li><strong>24/7</strong><span>sempre aberta</span></li>
            </ul>
        </div>
    </div>
</header>

<main>
    <section class="section" id="catalogo">
        <div class="section-heading">
            <h2>Jogos disponíveis</h2>
            <p>O catálogo vai crescendo — volta sempre a espreitar.</p>
        </div>

        <div class="game-grid">
            @foreach (var game in Catalog)
            {
                @* Um jogo em testes abre-se com um toque duplo de três dedos no cartão (ver wwwroot/secret-play.js). *@
                <article class="game-card @game.Theme @(game.IsPlayable ? "" : "muted")"
                         data-secret-play="@(game.IsPlayable ? null : game.PlayUrl)">
                    <div class="game-cover">
                        <img src="@game.Cover" alt="Ecrã de jogo: @game.Title" width="960" height="540"
                             loading="lazy" decoding="async" />
                        <span class="cover-crt" aria-hidden="true"></span>

                        @if (game.IsPlayable)
                        {
                            @if (game.Badge is not null)
                            {
                                <span class="cover-badge">@game.Badge</span>
                            }
                            <a class="cover-link" href="@game.PlayUrl" aria-label="Jogar @game.Title">
                                <span class="cover-play" aria-hidden="true">▶</span>
                            </a>
                        }
                        else
                        {
                            <span class="cover-stamp">Em breve</span>
                        }

                        <div class="game-marquee">
                            <span class="marquee-emoji" aria-hidden="true">@game.Emoji</span>
                            <div class="marquee-text">
                                <h3>@game.Title</h3>
                                <span class="marquee-tagline">@game.Tagline</span>
                            </div>
                        </div>
                    </div>

                    <div class="game-card-body">
                        <p>@game.Description</p>
                        <div class="game-card-actions">
                            @if (game.IsPlayable)
                            {
                                <a class="tile-action" href="@game.PlayUrl">@game.PlayLabel</a>
                                <a class="tile-action ghost" href="/pontuacoes?jogo=@game.Slug#@game.Slug">🏆 Pontuações</a>
                            }
                            else
                            {
                                <button class="tile-action muted" type="button" disabled>A caminho</button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>

    <p class="home-meta">
        Sem publicidade e sem rastreio — só jogos.
        <span class="home-meta-links">
            <a href="/suporte">Ajuda e contactos</a>
            <a href="/privacidade">Política de Privacidade</a>
        </span>
    </p>
</main>

@code {
    /// <summary>Um jogo do catálogo da arcada.</summary>
    /// <param name="Slug">Pasta do jogo em <c>wwwroot/games/</c> e id usado nas pontuações.</param>
    /// <param name="Theme">Classe CSS com a cor e o lettering do jogo.</param>
    /// <param name="Cover">Capa 16:9 gerada por <c>tools/covers/</c>.</param>
    /// <param name="Badge">Etiqueta opcional no canto da capa (ex.: "Novo").</param>
    /// <param name="IsPlayable">Jogos por lançar não têm link e levam o carimbo "Em breve".</param>
    private sealed record ArcadeGame(
        string Slug,
        string Title,
        string Tagline,
        string Description,
        string Emoji,
        string Theme,
        string Cover,
        string? Badge = null,
        bool IsPlayable = true,
        string PlayLabel = "Jogar")
    {
        public string PlayUrl => $"/games/{Slug}/";
    }

    private static readonly ArcadeGame[] Catalog =
    [
        new("tasca-do-ze",
            "Tasca do Zé",
            "o teu turno na cozinha",
            "Gere os pedidos, prepara os pratos certos e serve os clientes antes que percam a paciência.",
            "🍽️",
            "theme-tasca",
            "/covers/tasca-do-ze.webp"),

        new("pong",
            "Pong Retro",
            "retro • arcade",
            "Releitura neon do clássico Pong, com modo 1 jogador (vs. CPU) ou 2 jogadores no mesmo ecrã.",
            "🏓",
            "theme-pong",
            "/covers/pong.webp"),

        new("pixel-racing",
            "Pixel Racing",
            "boost • drift • torneios",
            "Corridas arcade em pistas curtas, com boost, drift e torneios. Tu e três adversários CPU.",
            "🏎️",
            "theme-racing",
            "/covers/pixel-racing.webp",
            Badge: "Novo"),

        new("maze-run",
            "Maze Run",
            "labirintos & fugas",
            "Foge aos guardas por labirintos com portais e portas trancadas, e desbloqueia o nível seguinte.",
            "🧩",
            "theme-maze",
            "/covers/maze-run.webp",
            Badge: "Novo"),

        new("terras-do-reino",
            "Terras do Reino",
            "campos • minas • mercados",
            "Semeia, colhe, abre minas e oficinas e faz do teu o reino mais próspero, sem guerras.",
            "🏰",
            "theme-reino",
            "/covers/terras-do-reino.webp",
            // Em testes: fica "Em breve" no catálogo, mas joga-se em
            // /games/terras-do-reino/ para quem lá for direto.
            IsPlayable: false)
    ];
}
