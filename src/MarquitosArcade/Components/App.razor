<!DOCTYPE html>
<html lang="pt-PT">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <base href="/" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon3_64x64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon3_32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon3_16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon3.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#eceffa" />
    <meta name="msapplication-TileColor" content="#6a5bf6" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Marquitos Arcade" />
    <ResourcePreloader />
    @* Aplica o tema guardado antes do primeiro paint (sem flash do tema errado). *@
    <script src="@Assets["theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["styles.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MarquitosArcade.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* A enhanced navigation do Blazor substitui o conteúdo por fetch e
       pode apagar o `data-theme` posto no <html> por wwwroot/theme.js
       (o servidor não tem noção da escolha do cliente). Reaplicamos o
       tema guardado a seguir a cada uma dessas navegações. *@
    <script>
        Blazor.addEventListener('enhancedload', () => window.__arcadeTheme?.reapply());
    </script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="@Assets["topnav-dropdown.js"]"></script>
</body>

</html>
