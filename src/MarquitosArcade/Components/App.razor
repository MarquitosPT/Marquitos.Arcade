<!DOCTYPE html>
<html lang="pt-PT">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <base href="/" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon3_64x64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon3_32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon3_16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon3.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#eceffa" />
    <meta name="msapplication-TileColor" content="#6a5bf6" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    @* O equivalente normalizado do anterior (Android/Chrome). *@
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Marquitos Arcade" />
    <ResourcePreloader />
    @* Aplica o tema guardado antes do primeiro paint (sem flash do tema errado). *@
    <script src="@Assets["theme.js"]"></script>
    @* Ecrã de arranque da arcada, partilhado com os jogos (wwwroot/lib/arcade/splash.*).
       Antes do styles.css porque é o primeiro que se vê; o logótipo vai pré-carregado
       para a barra não chegar ao fim antes da imagem. *@
    <link rel="preload" as="image" href="@Assets["logo3.png"]" />
    <link rel="stylesheet" href="@Assets["lib/arcade/splash.css"]" />
    @* Mede o viewport curto das apps afixadas em iOS (ver o ficheiro). *@
    <script src="@Assets["lib/arcade/standalone-fit.js"]"></script>
    @* Sem o menu de contexto do browser no botão direito (ver o ficheiro). *@
    <script src="@Assets["lib/arcade/no-context-menu.js"]"></script>
    <script type="module" src="@Assets["lib/arcade/splash-boot.js"]"></script>
    <link rel="stylesheet" href="@Assets["styles.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MarquitosArcade.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @* data-splash-once="session": a arcada arranca uma vez por separador, ao
       contrário dos jogos, que arrancam de cada vez que se abre um. E
       data-permanent para a enhanced navigation do Blazor não voltar a
       injetá-lo em cada navegação (ver o reapply() mais abaixo). *@
    <div id="arcadeSplash" class="arcade-splash" data-splash-once="session" data-permanent>
        <div class="arcade-splash-rays" aria-hidden="true"></div>
        <div class="arcade-splash-pixels" aria-hidden="true"></div>
        <div class="arcade-splash-stage">
            <img class="arcade-splash-logo" src="@Assets["logo3.png"]" width="512" height="366"
                 alt="MarquitosPT Game Arcade" fetchpriority="high" decoding="async" />
            <p class="arcade-splash-status" role="status">A carregar&hellip;</p>
            <div class="arcade-splash-track" role="progressbar" aria-label="Progresso do carregamento"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div class="arcade-splash-fill"></div>
            </div>
        </div>
    </div>

    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* A enhanced navigation do Blazor substitui o conteúdo por fetch e
       pode apagar o `data-theme` posto no <html> por wwwroot/theme.js
       (o servidor não tem noção da escolha do cliente). Reaplicamos o
       tema guardado a seguir a cada uma dessas navegações. *@
    <script>
        Blazor.addEventListener('enhancedload', () => {
            window.__arcadeTheme?.reapply();
            // Pela mesma razão: o HTML de cada página traz o ecrã de arranque, e
            // a sincronização do DOM podia trazê-lo de volta já sem ninguém para
            // o tirar (o splash-boot.js só corre uma vez por documento).
            window.__arcadeSplash?.reapply();
            // E o alvo de um fragmento no URL (ex.: /pontuacoes?jogo=pong#pong)
            // só existe no DOM depois desta sincronização.
            window.__arcadeHashScroll?.reapply();
            // O carrossel de jogos da página de pontuações guarda os cartões
            // numa cópia sua (ver wwwroot/pontuacoes.js); se esta navegação
            // trouxe outro jogo selecionado, essa cópia fica desatualizada.
            window.__arcadePontuacoes?.reapply();
        });
    </script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="@Assets["topnav-dropdown.js"]"></script>
    <script src="@Assets["hash-scroll.js"]"></script>
    <script src="@Assets["secret-play.js"]"></script>
    <script type="module" src="@Assets["pontuacoes.js"]"></script>
</body>

</html>
